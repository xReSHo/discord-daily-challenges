# Copy to .env and fill in. See README.md for where each value comes from.

# --- Discord OAuth (reuse your existing bot's Discord Application) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord bot token — lets the site grant shop roles directly (no queue). ---
# Same token as the bot. The bot must be in the guild with Manage Roles and a
# top role above every role the shop can grant.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=              # falls back to UNBELIEVABOAT_GUILD_ID

# --- NextAuth --- (generate with: npx auth secret)
AUTH_SECRET=
# Local dev: http://localhost:3000  |  Production: https://your-site.netlify.app
NEXTAUTH_URL=http://localhost:3000

# --- Database (Supabase or any Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- UnbelievaBoat ---
UNBELIEVABOAT_API_TOKEN=
UNBELIEVABOAT_GUILD_ID=
UNBELIEVABOAT_TEST_USER_ID=

# --- Daily challenge engine ---
CHALLENGE_TZ=Asia/Bahrain
WORDLE_REWARD_AMOUNT=250
WORDLE_SEED=change-me
TYPING_REWARD_AMOUNT=200
AIM_REWARD_AMOUNT=200
LITANY_REWARD_AMOUNT=500
TYPING_MAX_STRIKES=3
TYPING_MIN_WPM=30
AIM_TIME_LIMIT_MS=20000
LITANY_PASS_ROUND=10       # clear a sequence this long to pass the day

# --- Retry economy (defaults shown) ---
# Typing: fails 1..FREE are free; each further fail drops the day's prize by
# DROP; once it would hit 0 the day's typing is failed (locked).
TYPING_FREE_FAILS=6
TYPING_FAIL_DROP=100
# Aim: losing runs allowed before the day's aim round is failed.
AIM_MAX_TRIES=3
# Litany: each round cleared past LITANY_PASS_ROUND adds this to the prize on a
# seal; the ceiling on rounds (and prize).
LITANY_CONTINUE_BONUS=100
LITANY_MAX_ROUND=30
TYPING_SEED=change-me
AIM_SEED=change-me
LITANY_SEED=change-me
SESSION_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Geometry Dash (staked, one run per day) ---
GEODASH_SEED=change-me
# Fixed entry for easy/medium/hard. On a win you get this back plus the reward.
GEODASH_ENTRY=100
GEODASH_EASY_REWARD=100      # easy win pays entry + 100  (net +100)
GEODASH_MEDIUM_REWARD=300    # medium win pays entry + 300 (net +300)
GEODASH_HARD_REWARD=500      # hard win pays entry + 500   (net +500)
# Impossible: the player picks the stake (>= MIN, no max); a win pays 5x it.
# Running out of retries and paying again lets Impossible re-pick its stake.
GEODASH_IMPOSSIBLE_MIN=5000
# Optional hard ceiling on any single payout. Blank / 0 = uncapped.
GEODASH_MAX_PAYOUT=
# Free restarts per fee. After this many deaths the player must pay the fee
# again to keep playing that run. Resets on re-pay and at midnight.
GEODASH_MAX_RESTARTS=5
# An open run with no submission (and no deaths) is auto-refunded after this
# many minutes — the day's run is not consumed.
GEODASH_RUN_TTL_MIN=20

# --- Phase 7: hardening ---
# Discord user ids allowed to open /admin (comma-separated). These users also
# get the header "Dev" toggle: while on, they can replay games with no daily
# cooldown (nothing is recorded and no rewards are paid).
ADMIN_DISCORD_IDS=
# API rate limits, requests per client per minute (optional; defaults apply).
RATE_LIMIT_READ=60
RATE_LIMIT_MUTATE=20
RATE_LIMIT_START=12
RATE_LIMIT_AUTH=20
RATE_LIMIT_BOSS=150
RATE_LIMIT_CHAT=15

# --- Website assistant (chatbot) ---
# The site calls Google's OpenAI-compatible Gemini endpoint directly (streamed).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-lite-latest is the low-latency model (~1s to first token) and is
# plenty for scoped Q&A. Use gemini-flash-latest for a stronger, slower model.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# When the assistant can't reach the model it DMs this Discord user (via the bot
# token above). Blank = first entry of ADMIN_DISCORD_IDS.
CHAT_ALERT_DISCORD_ID=
# Minutes to wait between owner DMs during an outage (one alert, not hundreds).
CHAT_ALERT_THROTTLE_MIN=10

# --- Website shop ---
# Bearer token the Discord bot presents to /api/shop/expiring to remove expired
# temporary-pass roles. MUST match the bot's value. Generate: openssl rand -base64 32
SHOP_FULFILL_SECRET=

# --- Weekly boss raid ---
# Must match the bot's BOSS_RESOLVE_SECRET. Generate: openssl rand -base64 32
BOSS_RESOLVE_SECRET=
# The 5-boss roster (name / mechanic / HP / prize / penalty / params) lives in
# the DB — seed it with `node scripts/seed-boss-roster.mjs` and tune it on
# /admin/boss. One boss is drawn at random each week, never the same two weeks
# running. The vars below are only the pre-roster fallback + the shared schedule.
BOSS_SPAWN_DOW=6            # 0=Sun .. 6=Sat
BOSS_SPAWN_HOUR=16
BOSS_DESPAWN_HOUR=23
BOSS_DESPAWN_MIN=59
BOSS_MAX_HP=5000
BOSS_DMG_PER_CLICK=0.1
BOSS_MAX_CPS=10
BOSS_SLAY_REWARD=10000
BOSS_FAIL_PENALTY=2000
BOSS_NAME=Veyrath, The Hollow Sovereign

# --- Achievements ---
# The 5-achievement catalog lives in code (src/lib/achievements/catalog.ts) —
# nothing here to tune per-achievement. This is only the Discord role id the
# "Perfect Day" achievement grants (via the same bot token as the shop, see
# DISCORD_BOT_TOKEN above). Create the role, enable Developer Mode in Discord,
# right-click it -> Copy Role ID. Leave blank to ship without it: the
# achievement still unlocks and shows on /achievements, the role grant is just
# skipped (and retried automatically once this is set).
ACHIEVEMENT_DEVOUT_ROLE_ID=

# --- Feedback (bug reports & suggestions) ---
# Reports arrive two ways: the bot's /report command (-> /api/feedback/intake),
# and the website chat widget's support fallback when the assistant is down
# (-> /api/feedback). This MUST match the bot's FEEDBACK_SECRET.
FEEDBACK_SECRET=
# Discord webhook that delivers a website-submitted report to your feedback
# channel. If unset, cogs/feedback.py polls and DMs you instead.
FEEDBACK_WEBHOOK_URL=
