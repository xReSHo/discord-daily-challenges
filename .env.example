# Copy to .env and fill in. See README.md for where each value comes from.

# --- Discord OAuth (reuse your existing bot's Discord Application) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- NextAuth --- (generate with: npx auth secret)
AUTH_SECRET=
# Local dev: http://localhost:3000  |  Production: https://your-site.netlify.app
NEXTAUTH_URL=http://localhost:3000

# --- Database (Supabase or any Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- UnbelievaBoat ---
UNBELIEVABOAT_API_TOKEN=
UNBELIEVABOAT_GUILD_ID=
UNBELIEVABOAT_TEST_USER_ID=

# --- Daily challenge engine ---
CHALLENGE_TZ=Asia/Bahrain
WORDLE_REWARD_AMOUNT=250
WORDLE_SEED=change-me
TYPING_REWARD_AMOUNT=200
AIM_REWARD_AMOUNT=200
TYPING_MAX_STRIKES=3
TYPING_MIN_WPM=30
AIM_TIME_LIMIT_MS=20000
TYPING_SEED=change-me
AIM_SEED=change-me
SESSION_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Phase 7: hardening ---
# Discord user ids allowed to open /admin (comma-separated).
ADMIN_DISCORD_IDS=
# API rate limits, requests per client per minute (optional; defaults apply).
RATE_LIMIT_READ=60
RATE_LIMIT_MUTATE=20
RATE_LIMIT_START=12
RATE_LIMIT_AUTH=20
