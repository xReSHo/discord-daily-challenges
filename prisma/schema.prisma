generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Netlify's Linux build +
  // serverless functions need to load the query engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Required by NextAuth's Prisma adapter, do not rename fields ---

model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Phase 2: daily content engine + completion tracking ---

/// One row per (day, section). Holds the seeded content a section needs
/// for that day (e.g. the Wordle word). The Phase 2 dummy section does
/// not need a payload, but real sections from Phase 3 on will.
model DailyContent {
  id        String   @id @default(cuid())
  /// The challenge day this content belongs to, at 00:00 UTC. The wall-clock
  /// day is computed in CHALLENGE_TZ (see src/lib/challenge-date.ts).
  date      DateTime @db.Date
  section   String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([date, section])
}

/// One row per (user, section, day). The unique constraint is what makes
/// "once per day" impossible to violate even under concurrent requests.
model Completion {
  id           String   @id @default(cuid())
  discordId    String
  section      String
  date         DateTime @db.Date
  /// Whether the UnbelievaBoat payout succeeded. A row with rewarded=false
  /// means the completion landed but the payout call failed; it is cleaned
  /// up so the user can retry (see src/lib/completions.ts).
  rewarded     Boolean  @default(false)
  rewardAmount Int
  createdAt    DateTime @default(now())

  @@unique([discordId, section, date])
  @@index([discordId, date])
  @@index([createdAt])
}

// --- Phase 3: Wordle ---

/// One row per (user, day). Stores only the raw guesses; per-letter results
/// are recomputed server-side from the daily word, so the answer never needs
/// to live in this table. `finished` caps the game at MAX_GUESSES.
model WordleGame {
  discordId String
  date      DateTime @db.Date
  guesses   String[] @default([])
  won       Boolean  @default(false)
  finished  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([discordId, date])
}

// --- Phase 7: rate limiting + anti-cheat audit log ---

/// Fixed-window rate-limit counter. `id` is `"<key>@<windowStartMs>"` so a
/// single upsert both creates the window and increments it. Old rows are
/// swept opportunistically (see src/lib/rate-limit.ts); the table is safe to
/// truncate at any time.
model RateLimit {
  id          String   @id
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

/// An attempt the anti-cheat checks rejected as implausible — not benign
/// failures like "session expired" or "didn't finish". Surfaced on /admin.
model SuspiciousAttempt {
  id        String   @id @default(cuid())
  discordId String
  section   String
  reason    String
  detail    Json     @default("{}")
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([discordId, createdAt])
}

// --- Weekly boss raid ---

/// The roster of possible bosses. One is picked at random for each weekly spawn
/// (never the same boss two weeks running). Edited from /admin/boss. `params`
/// holds mechanic-specific knobs (dmgPerClick/maxCps for the clicker, the
/// eclipse cycle, the sac schedule, the mini-arena tuning). Both the stats and
/// `params` are snapshotted onto the Boss row at spawn so a later roster edit
/// never retro-changes a running fight or a past payout.
model BossTemplate {
  key        String   @id // "veyrath" | "grieveth" | "nyrrek" | "silt-cardinal" | "unraveled-saint"
  name       String
  mechanic   String   @default("clicker") // "clicker" | "eclipse" | "weakpoint" | "miniarena"
  enabled    Boolean  @default(true)
  maxHp      Int
  rewardPool Int
  penalty    Int
  image      String // "/boss/grieveth-idle" — .webp + .png siblings under public/
  blurb      String // one-line "how to fight" for the bot spawn embed + the arena
  params     Json     @default("{}")
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// One row per weekly boss (keyed by the Saturday it spawned). `dealtDamage`
/// is the denormalised running total across all fighters, so "is it dead?" is
/// a single indexed read rather than a SUM over BossHit.
model Boss {
  id          String    @id @default(cuid())
  /// A non-unique label — the Saturday for weekly bosses, the spawn date for
  /// manual ones. Dedup is on `dedupeKey`.
  weekOf      DateTime  @db.Date
  /// "weekly:<YYYY-MM-DD>" for the recurring raid, "manual:<cuid>" for an
  /// admin spawn. Lets the lazy weekly create stay P2002-race-safe. Always set
  /// by the code on create; nullable only so `db push` tolerates old rows.
  dedupeKey   String?   @unique
  source      String    @default("weekly") // "weekly" | "manual"
  /// The BossTemplate this was spawned from (null for legacy / bespoke spawns).
  templateKey String?
  /// Params are snapshotted at spawn so editing the roster later never
  /// retro-changes a running fight or a past payout.
  name        String    @default("Veyrath, The Hollow Sovereign")
  mechanic    String    @default("clicker")
  /// Snapshot of the template's `params` at spawn (mechanic knobs).
  params      Json?
  image       String    @default("/boss/veyrath-idle")
  blurb       String    @default("")
  maxHp       Int
  rewardPool  Int       @default(10000)
  penalty     Int       @default(2000)
  /// Admin-spawned test boss: only admins see or can fight it.
  adminOnly   Boolean   @default(false)
  /// Whether resolveBoss actually moves UnbelievaBoat coins.
  paysOut     Boolean   @default(true)
  dealtDamage Float     @default(0)
  spawnsAt    DateTime
  expiresAt   DateTime
  slain       Boolean   @default(false)
  slainAt     DateTime?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  hits        BossHit[]

  @@index([resolvedAt])
  @@index([spawnsAt, expiresAt])
}

/// Singleton (`id = "singleton"`) holding the weekly spawn window + global
/// switch. Edited from /admin/boss. The per-boss stat fields are legacy (the
/// roster owns those now) and fall back to the env defaults in
/// src/lib/boss/config.ts.
model BossConfig {
  id            String   @id @default("singleton")
  name          String
  maxHp         Int
  rewardPool    Int
  penalty       Int
  dmgPerClick   Float
  maxCps        Int
  spawnDow      Int // 0 = Sunday .. 6 = Saturday
  spawnHour     Int
  despawnHour   Int
  despawnMin    Int
  weeklyEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// One row per (boss, fighter). `damage` drives the bounty split; `settled`
/// marks that the reward or penalty for this fighter has been paid. `meta`
/// carries per-fighter mechanic state (miss streak, mini-run cooldown, …).
model BossHit {
  id        String   @id @default(cuid())
  bossId    String
  boss      Boss     @relation(fields: [bossId], references: [id], onDelete: Cascade)
  discordId String
  damage    Float    @default(0)
  clicks    Int      @default(0)
  meta      Json?
  lastHitAt DateTime @default(now())
  settled   Boolean  @default(false)
  payout    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bossId, discordId])
  @@index([bossId])
}

// --- Personal-best score capture (profile page + future leaderboards) ---

/// One row per scored run (paid or practice). Keeps the raw metric so a
/// personal best is just `MAX(value)` / `MIN(value)` per (discordId, section).
model GameScore {
  id        String   @id @default(cuid())
  discordId String
  section   String
  date      DateTime @db.Date
  /// "wpm" | "aimMs" | "litanyRound" | "geoPercent"
  metric    String
  value     Float
  createdAt DateTime @default(now())

  @@index([discordId, section])
  @@index([section, metric])
}

// --- Geometry Dash: staked, one-play-per-day auto-runner ---

/// One row per (user, challenge-day). Unlike the other games, geodash charges
/// coins up front (`stake`, split `paidCash`/`paidBank` for an exact refund).
/// A death is not terminal: the player gets up to GEODASH_MAX_RESTARTS free
/// restarts per fee, then must pay the fee again to continue (Impossible re-picks
/// its stake). `status`:
///   open      — an attempt is live / restartable (fresh token)
///   spent     — died and out of free restarts; awaiting a re-payment
///   won       — cleared (terminal)
///   rejected  — anti-cheat forfeit (terminal)
///   refunded  — abandoned before any death; the day's play is NOT consumed
model GeoRun {
  id          String    @id @default(cuid())
  discordId   String
  date        DateTime  @db.Date
  difficulty  String // easy | medium | hard | impossible
  /// current stake — for Impossible this is updated each time the fee is re-paid
  stake       Int
  paidCash    Int       @default(0)
  paidBank    Int       @default(0)
  status      String    @default("open")
  payout      Int       @default(0)
  distancePct Float     @default(0)
  /// free restarts consumed since the last fee payment (resets on re-pay / new day)
  restarts    Int       @default(0)
  /// total deaths this run (all fee blocks) — abandon-refund only applies at 0
  deaths      Int       @default(0)
  /// how many times the fee has been paid (1 = the initial entry)
  feesPaid    Int       @default(1)
  /// ms epoch of the currently-issued run token — drives the abandon-refund TTL.
  tokenIat    BigInt
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([discordId, date])
  @@index([status])
  @@index([resolvedAt])
}

// --- Per-day attempt tracking (retry limits + failed-challenge lockout) ---

/// One row per (user, section, day) once they've failed a run. `fails` counts
/// losing attempts; `failed` means the day's challenge is locked (out of tries,
/// or a litany gamble lost). Created lazily on the first fail — its absence
/// means "no fails yet". See src/lib/attempts.ts.
model DailyAttempt {
  id        String   @id @default(cuid())
  discordId String
  section   String
  date      DateTime @db.Date
  fails     Int      @default(0)
  failed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([discordId, section, date])
  @@index([date])
}

// --- Support widget: bug reports & suggestions ---

/// One row per submission from the in-app feedback widget. `delivered` flips
/// once it has reached the owner (via the Discord webhook, or the bot DM
/// fallback). Surfaced on /admin.
model Feedback {
  id        String   @id @default(cuid())
  discordId String
  kind      String // "bug" | "idea"
  message   String
  path      String   @default("/")
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([delivered])
}

// --- Website shop: buyable in-house items (see src/lib/shop/website-items.ts) ---

/// One purchase of a website shop item. Coins are charged up front (cash first,
/// then bank — `paidCash`/`paidBank` record the split so a refund is exact),
/// then the site grants the Discord role synchronously.
/// `status`: charging (during the buy) -> fulfilled | refunded (grant failed).
/// For a temporary pass, `roleExpiresAt` is set; the bot's expiry sweep removes
/// the role after it passes and flips `roleRemoved`.
model Purchase {
  id            String    @id @default(cuid())
  discordId     String
  itemId        String
  itemName      String
  price         Int
  paidCash      Int       @default(0)
  paidBank      Int       @default(0)
  status        String    @default("charging")
  roleId        String?
  durationSec   Int       @default(0)
  /// null = permanent. When set and passed, the bot removes the role.
  roleExpiresAt DateTime?
  roleRemoved   Boolean   @default(false)
  error         String?
  fulfilledAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([discordId, createdAt])
  @@index([itemId])
  @@index([roleExpiresAt, roleRemoved])
}

// --- Website assistant: upstream (Gemini) failures ---

/// One row each time the site's chat assistant fails to get a reply from its
/// language model. `notified` flips once the owner has been DM'd about it; the
/// notifier throttles so an outage sends one DM, not hundreds. Surfaced on /admin.
model ChatIncident {
  id        String   @id @default(cuid())
  discordId String // the user who was chatting when it failed
  reason    String // "unconfigured" | "timeout" | "upstream" | "empty" | "error"
  detail    String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([notified])
}

// --- Achievements ---

/// One row per (user, achievement) unlock. The catalog itself (name, icon,
/// description, reward) lives in code at src/lib/achievements/catalog.ts — this
/// table is only unlock state. `seenAt` gates the unlock popup: null until the
/// toast has shown it once. `rewardGranted` tracks whether the reward side-effect
/// (coin payout / Discord role grant) actually landed; false rows are retried
/// opportunistically the next time this user's achievements are evaluated.
model Achievement {
  id            String    @id @default(cuid())
  discordId     String
  key           String
  unlockedAt    DateTime  @default(now())
  seenAt        DateTime?
  rewardGranted Boolean   @default(false)

  @@unique([discordId, key])
  @@index([discordId, seenAt])
}

// --- Admin game kill-switch ---

/// One row per game section that an admin has touched. Absent row = enabled.
/// `disabled` takes the game offline (page shows a notice, mutating APIs 503);
/// `note` is the player-facing reason.
model SectionStatus {
  section   String   @id // wordle | typing | aim | litany | geodash
  disabled  Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
}
